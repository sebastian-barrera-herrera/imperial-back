# --- Base de datos (coincide con docker-compose.yml) ---
DATABASE_URL="postgresql://imperial:imperial@localhost:5432/imperial?schema=public"

# --- Secretos: genera valores reales para cualquier entorno que no sea tu máquina ---
# JWT_SECRET:           openssl rand -base64 48
# DATA_ENCRYPTION_KEY:  openssl rand -base64 32   (cifra cédula y cuenta bancaria; si lo pierdes, esos datos son irrecuperables)
JWT_SECRET="change-me-jwt-secret-change-me-jwt-secret-0123456789"
DATA_ENCRYPTION_KEY="change-me-change-me-change-me-change-me-aaa"

# --- Servidor ---
PORT=4000
# Origen(es) del frontend permitidos (separados por coma). Con el proxy de Next no se usa desde el navegador.
CORS_ORIGIN="http://localhost:3000"
# Cookies "Secure": por defecto true en producción. Pon false solo para pruebas por http.
# COOKIE_SECURE=false

# --- Archivos y negocio ---
STORAGE_DIR="storage"
DEFAULT_CURRENCY="USD"

# --- Solo para `npm run db:seed` (crea/actualiza el superadmin inicial) ---
# SUPERADMIN_EMAIL="admin@tudespacho.com"
# SUPERADMIN_PASSWORD="UnaClaveLarga123"
# SUPERADMIN_NAME="Superadministrador"
